{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CepheidCalc",
  "version": "0.1.0",
  "identifier": "com.rip.myapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://192.168.1.216:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "http": {
      "enabled": true
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "http": {
        "request": true,
        "scope": [
          "http://192.168.1.216:8080/**"
        ]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CepheidCalculator",
        "width": 2000,
        "height": 1200,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
